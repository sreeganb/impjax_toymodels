{
  "name": "kcoil_ecoil_sweep",
  "output_dir": "out/benchmark",
  "copy_numbers": [1, 2, 3],
  "samplers": ["rmh", "smc", "smc_tempered", "smc_adaptive", "imp_rex"],
  "score_window": 50,
  "satisfaction_tolerance": 2.0,
  "seed": 0,
  "prior": "flat",

  "ground_truth": {
    "structure": "data/pdb/kcoil_ecoil.pdb",
    "contact_map": "data/contact_maps/kcoil_ecoil_n1.csv",
    "chains": {"A": ["KCOIL", 0], "B": ["ECOIL", 0]},
    "per_copy_number": {}
  },

  "restraints": {
    "top_n": 10,
    "top_n_intra": 2,
    "residue_types": "KS",
    "min_seq_sep": 3,
    "force_constant": 1.0,
    "wildcard_copies": true
  },

  "proposal": {
    "mode": "all",
    "sigma_rotation": 0.05,
    "sigma_translation": 1.0,
    "sigma_bead": 1.0
  },

  "sampler_params": {
    "n_steps": 4000,
    "burnin": 0,
    "thin": 1,
    "n_particles": 256,
    "n_temperature_steps": 100,
    "n_mcmc_steps": 20,
    "schedule": "linear",
    "target_ess": 0.6,
    "imp_rex_frames": 500,
    "imp_rex_mc_steps": 10,
    "imp_rex_max_temp": 2.5
  }
}
