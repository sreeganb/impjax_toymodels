{
  "name": "1avx_docking_sweep",
  "system": "docking_system",
  "metrics_module": "docking_metrics",
  "output_dir": "out/benchmark_4res",
  "copy_numbers": [
    1
  ],
  "samplers": [
    "rmh",
    "smc",
    "smc_tempered",
    "smc_adaptive",
    "imp_rex"
  ],
  "score_window": 100,
  "score_window_fraction": 0.25,
  "satisfaction_tolerance": 2.0,
  "seed": 0,
  "seeds": [0, 1, 2, 3, 4],
  "prior": "split+box",
  "prior_box_half_width": 100.0,
  "ground_truth": {
    "structure": "data/pdb/1avx_complex.pdb",
    "contact_map": "data/contact_maps/1avx_n1.csv",
    "chains": {
      "A": [
        "TRYP",
        0
      ],
      "B": [
        "STI",
        0
      ]
    },
    "per_copy_number": {}
  },
  "restraints": {
    "top_n": 4,
    "top_n_intra": 0,
    "residue_types": "KS",
    "min_seq_sep": 3,
    "force_constant": 1.0,
    "wildcard_copies": true
  },
  "proposal": {
    "mode": "rigid",
    "sigma_rotation": 0.02,
    "sigma_translation": 0.25,
    "sigma_bead": 1.0
  },
  "sampler_params": {
    "n_steps": 30000,
    "burnin": 100,
    "thin": 5,
    "n_particles": 100,
    "n_temperature_steps": 100,
    "n_mcmc_steps": 10,
    "schedule": "geometric",
    "target_ess": 0.6,
    "imp_rex_frames": 60000,
    "imp_rex_mc_steps": 10,
    "imp_rex_max_temp": 4.0
  }
}
